# Logs (regenerated by the launchd service)
*.log

# Node
node_modules/

# OS
.DS_Store

# Secrets never live in the repo — they're in ~/.strava-proxy/auth.json
# (kept outside this folder on purpose). Listed here as a guard in case
# anyone ever copies it in.
auth.json
.env

# Google service account keys (the JSON downloaded from Google Cloud). This repo is
# public, so the key must only ever live in Vercel's env vars.
coach-hub-*.json
*service-account*.json
